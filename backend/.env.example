# Copy to backend/.env and adjust. Every value has a safe default except the curator account.

# The first curator account, created on start if it does not exist. Change the password.
CURATOR_LOGIN=curator
CURATOR_PASSWORD=change-me-before-sharing

# auto: COLMAP when pycolmap sees a CUDA GPU, otherwise the clearly labelled demo pipeline.
# colmap: always COLMAP (jobs fail with a clear message without a GPU). demo: always demo.
PIPELINE=auto

# SQLite file in backend/storage by default. Postgres example:
# DATABASE_URL=postgresql+psycopg://vitrine:secret@localhost:5432/vitrine

# Where uploads, models and thumbnails are stored. Default: backend/storage
# STORAGE_DIR=/var/lib/vitrine

# Origins allowed to call the API from a browser (comma-separated).
# CORS_ORIGINS=http://localhost:5173

# Set to true behind HTTPS so the session cookie is only sent over TLS.
COOKIE_SECURE=false

# Seconds each simulated stage takes in the demo pipeline.
DEMO_STAGE_SECONDS=1.5
